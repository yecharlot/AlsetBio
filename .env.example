# AlsetBio — Nodo Alset para laboratorios (LabFlow)
PORT=8080

# Persistencia: si no defines Supabase, se usa disco local (alset_data/)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_TABLE=alset_kv

# Relay cloud (opcional)
# RENDER=true

# LabFlow auth: if true, Bearer token required on LabFlow APIs (except public /verify)
# LABFLOW_REQUIRE_AUTH=false

